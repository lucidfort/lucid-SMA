generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma"
  output       = "../lib/generated/pothos-prisma-types.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// School and Organizational Structure
model School {
  id      String  @id @default(uuid())
  slug    String  @unique
  name    String
  email   String
  phone   String
  address String
  motto   String?
  logo    String?

  programs                  Program[]
  grades                    Grade[]
  classes                   Class[]
  academicYears             AcademicYear[]
  terms                     Term[]
  students                  Student[]
  managers                  Manager[]
  staffs                    Staff[]
  parents                   Parent[]
  subjects                  Subject[]
  timetablePeriods          TimetablePeriod[]
  exams                     Exam[]
  assignments               Assessment[]
  examResults               ExamResult[]
  assessmentResult          AssessmentResult[]
  termlyResults             TermlyResult[]
  events                    Event[]
  studentAttendances        ClassAttendance[]
  staffAttendances          StaffAttendance[]
  announcements             Announcement[]
  invoices                  Invoice[]
  salaryPayments            PayrollTransaction[]
  payments                  InvoicePayment[]
  payrollProfiles           PayrollProfile[]
  teacherSubjectAssignments TeacherSubjectAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id        String    @id @default(uuid())
  year      String
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms               Term[]
  studentClassHistory StudentClassHistory[]

  @@unique([schoolId, year])
}

model Term {
  id        String    @id @default(uuid())
  session   Int
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  exams              Exam[]
  assignments        Assessment[]
  studentAttendances ClassAttendance[]
  staffAttendances   StaffAttendance[]
  invoices           Invoice[]
  termlyResults      TermlyResult[]

  @@unique([schoolId, academicYearId, session])
}

// ACADEMIC STRUCTURE
model Program {
  id       String      @id @default(uuid())
  name     ProgramType
  isActive Boolean     @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  grades Grade[]

  @@unique([schoolId, name])
}

model Grade {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)

  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  classes                   Class[]
  exams                     Exam[]
  invoices                  Invoice[]
  events                    Event[]
  announcements             Announcement[]
  teacherSubjectAssignments TeacherSubjectAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model Class {
  id       String  @id @default(uuid())
  name     String
  capacity Int
  isActive Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeId  String
  grade    Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  students             Student[]
  supervisors          ClassSupervisor[]
  assignments          Assessment[]
  attendances          ClassAttendance[]
  timetableAssignments TimetableAssignment[]
  studentsHistory      StudentClassHistory[]
  termlyResults        TermlyResult[]

  @@unique([schoolId, gradeId, name])
}

model Subject {
  id   String @id @default(uuid())
  name String

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  exams                     Exam[]
  assignments               Assessment[]
  timetableAssignments      TimetableAssignment[]
  teacherSubjectAssignments TeacherSubjectAssignment[]

  @@unique([schoolId, name])
}

// TIMETABLING AND SCHEDULING
model TimetablePeriod {
  id          String @id @default(uuid())
  startMinute Int
  endMinute   Int

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  assignments TimetableAssignment[]

  @@unique([schoolId, startMinute, endMinute])
}

model TimetableAssignment {
  id        String @id @default(uuid())
  dayOfWeek Int

  periodId  String
  classId   String
  teacherId String?
  subjectId String?
  activity  String?

  period  TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  class   Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Staff?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  subject Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([classId, dayOfWeek, periodId])
}

// PEOPLE
model Manager {
  id          String @id @default(uuid())
  clerkUserId String @unique
  username    String @unique
  name        String
  surname     String
  email       String
  phone       String

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@index([schoolId, name, surname])
}

model Student {
  id                 String        @id @default(uuid())
  registrationNumber String
  name               String
  surname            String
  address            String
  img                String?
  birthday           DateTime
  medicalCondition   String?
  sex                UserSex
  admissionDate      DateTime?
  status             StudentStatus @default(ACTIVE)

  schoolId String
  classId  String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  parentStudents      ParentStudent[]
  attendances         ClassAttendance[]
  invoicePayments     InvoicePayment[]
  studentClassHistory StudentClassHistory[]
  exams               ExamResult[]
  assessments         AssessmentResult[]
  termlyResults       TermlyResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, registrationNumber])
  @@index([schoolId, name, surname, status])
}

model Staff {
  id              String            @id @default(uuid())
  clerkUserId     String?           @unique
  employeeId      String
  name            String
  surname         String
  email           String?
  phone           String
  address         String
  img             String?
  birthday        DateTime
  sex             UserSex
  contractType    StaffContractType @default(PERMANENT)
  accessLevel     AccessLevel       @default(RESTRICTED)
  role            String
  isActive        Boolean           @default(true)
  hireDate        DateTime?
  terminationDate DateTime?
  exitReason      String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  payrollProfile PayrollProfile?

  classes                   ClassSupervisor[]
  timetableAssignments      TimetableAssignment[]
  attendances               StaffAttendance[]
  teacherSubjectAssignments TeacherSubjectAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@index([schoolId, name, surname, isActive])
}

model ClassSupervisor {
  classId   String
  teacherId String
  isActive  Boolean @default(true)

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Staff @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  assignmentDate DateTime?

  @@id([classId, teacherId])
}

model Parent {
  id          String  @id @default(uuid())
  clerkUserId String? @unique
  primaryId   String? @unique
  name        String
  surname     String
  email       String?
  phone       String
  address     String

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  parentStudents ParentStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, email])
  @@unique([schoolId, phone])
}

model ParentStudent {
  parentId  String
  studentId String
  relation  ParentStudentRelationship
  isPrimary Boolean

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

model StudentClassHistory {
  id             String             @id @default(uuid())
  classId        String
  studentId      String
  academicYearId String
  status         ClassHistoryStatus

  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, academicYearId, classId])
}

model ClassAttendance {
  id          String           @id @default(uuid())
  date        DateTime         @db.Date
  status      AttendanceStatus
  note        String?
  arrivalTime String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId   String
  term     Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classId, studentId, date])
  @@index([studentId, date])
}

model StaffAttendance {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  clockInTime String?
  note        String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId   String
  term     Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  staffId  String
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([schoolId, staffId, date])
  @@index([staffId, date])
}

model Exam {
  id        String   @id @default(uuid())
  paperCode String?
  date      DateTime
  maxScore  Int
  type      ExamType

  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeId   String
  grade     Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  termId    String
  term      Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  results ExamResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, subjectId, gradeId, termId, type])
}

model Assessment {
  id        String   @id @default(uuid())
  dueDate   DateTime
  maxScore  Int
  questions Json?

  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId    String
  term      Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  results AssessmentResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, termId, subjectId, classId])
}

model AssessmentResult {
  id         String   @id @default(uuid())
  score      Int
  uploadedAt DateTime @default(now())

  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assessment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, assignmentId])
}

model ExamResult {
  id         String   @id @default(uuid())
  score      Int
  uploadedAt DateTime @default(now())

  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([schoolId, studentId, examId])
}

model TermlyResult {
  id         String @id @default(uuid())
  totalScore Float
  average    Float
  position   Int
  remarks    String

  schoolId  String
  termId    String
  studentId String
  classId   String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  breakdown Json

  publishedAt DateTime @default(now())

  @@unique([termId, studentId])
}

model Invoice {
  id      String    @id @default(uuid())
  number  String
  title   String
  amount  Int
  dueDate DateTime?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId   String
  term     Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  grades   Grade[]
  payments InvoicePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, number])
}

model InvoicePayment {
  id         String        @id @default(uuid())
  amountPaid Float
  currency   String        @default("NGN")
  reference  String
  payerEmail String
  method     String?
  status     PaymentStatus @default(PENDING)

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  schoolId  String
  invoiceId String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  students Student[]

  @@unique([schoolId, reference])
}

model PayrollProfile {
  id            String  @id @default(uuid())
  accountName   String
  accountNumber String
  bankName      String
  bankCode      String
  recipientCode String
  salary        Int
  isActive      Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  staffId String @unique
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  transactions PayrollTransaction[]
}

model PayrollTransaction {
  id          String        @id @default(uuid())
  amount      Int
  year        Int
  month       Int
  paymentDate DateTime?
  status      PaymentStatus @default(PENDING)

  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profileId String
  profile   PayrollProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  lastSyncedAt DateTime @updatedAt

  deductions PayrollTransactionDeduction[]

  @@unique([profileId, month, year])
}

model PayrollTransactionDeduction {
  id     String @id @default(uuid())
  reason String
  amount Int

  transactionId String
  transaction   PayrollTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

// EVENTS AND COMMUNICATION
model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime

  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeId  String?
  grade    Grade?  @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  staffOnly Boolean  @default(false)
  viewedBy  String[]

  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeId  String?
  grade    Grade?  @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// For secondary schools or special subjects only
model TeacherSubjectAssignment {
  id        String @id @default(uuid())
  teacherId String
  subjectId String
  schoolId  String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Staff   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  grades    Grade[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, teacherId, subjectId])
}

// ENUMS
enum AccessLevel {
  FINANCE
  ACADEMICS
  ADMINISTRATION
  TEACHER
  RESTRICTED
}

enum UserSex {
  MALE
  FEMALE
}

enum ProgramType {
  CRECHE
  NURSERY
  PRIMARY
  SECONDARY
}

enum StaffContractType {
  PERMANENT
  CONTRACT
  PART_TIME
}

enum ParentStudentRelationship {
  FATHER
  MOTHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  EXPELLED
  SUSPENDED
}

enum ExamType {
  QUIZ
  TEST
  FINAL
  MIDTERM
  PRACTICAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ClassHistoryStatus {
  PROMOTED
  DEMOTED
}
